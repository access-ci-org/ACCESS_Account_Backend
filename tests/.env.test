# Dummy configuration used ONLY by the test suite.
#
# conftest.py sets APP_CONFIG to point at this file BEFORE any application
# module is imported, so importing `config`/`main` during tests never reads the
# real secrets .env symlink (~/secrets/access-account-api.env).
#
# Values here are fake. Base URLs use resolvable-looking test hosts so respx can
# match outbound requests in the client-level tests.

# --- Application ---
# adminuser is used by the auth-gate tests to exercise the admin branch.
ADMIN_USERNAMES=adminuser
CORS_ORIGINS=http://localhost:3000
# In-memory SQLite keeps import cheap; OTP-service tests rebind database.engine
# to an isolated temp file via the `temp_db` fixture.
DATABASE_URL=sqlite:///:memory:
# DEBUG=true makes /auth/send-otp log the OTP instead of calling AWS SES.
DEBUG=true

# --- AWS SES (never actually called in tests) ---
AWS_ACCESS_KEY=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-2
AWS_SES_SENDER_EMAIL=noreply@access-ci.test

# --- CILogon ---
CILOGON_LINK_CLIENT_ID=cilogon-link-client-id
CILOGON_LINK_CLIENT_SECRET=cilogon-link-client-secret
CILOGON_LOGIN_CLIENT_ID=cilogon-login-client-id
CILOGON_LOGIN_CLIENT_SECRET=cilogon-login-client-secret
CILOGON_AUTHORIZATION_URL=https://cilogon.test/authorize
CILOGON_TOKEN_URL=https://cilogon.test/oauth2/token
CILOGON_USER_INFO_URL=https://cilogon.test/oauth2/userinfo

# --- CoManage Registry / Core-API ---
COMANAGE_REGISTRY_BASE_URL=https://comanage.test
COMANAGE_REGISTRY_USER=comanage-user
COMANAGE_REGISTRY_PASSWORD=comanage-password
COMANAGE_REGISTRY_COID=2
COMANAGE_REGISTRY_KRB_AUTH_ID=1
COMANAGE_REGISTRY_TIMEOUT=10

# --- JWT ---
JWT_SECRET_KEY=test-jwt-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ISSUER=https://account.access-ci.org
JWT_AUDIENCE=https://account.access-ci.org
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate limiting (in-process memory backend) ---
RATE_LIMIT_STORAGE_URL=memory://

# --- OTP ---
OTP_CHARACTER_LENGTH=6
OTP_LIFETIME_MINUTES=30

# --- Cron intervals (large values so background jobs don't fire mid-test) ---
EXPIRED_OTP_CLEANUP_INTERVAL_SECONDS=86400
IDP_BY_DOMAIN_CACHE_REFRESH_INTERVAL_SECONDS=86400

# --- XRAS Identity Service ---
XRAS_IDENTITY_SERVICE_BASE_URL=https://xras.test
XRAS_IDENTITY_SERVICE_KEY=xras-api-key
XRAS_IDENTITY_SERVICE_REQUESTER=xras-requester
